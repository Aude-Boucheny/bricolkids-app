{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/icons/**",
              "components/motifs/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Mulish))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Mulish."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|disabled|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, disabled, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|outline|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'outline' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|outlined|children|key|ref|className|style|children)$/]",
        "message": "<DisplayTitle> doesn't accept that prop. Declared props: as, size, outlined, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|div)$/]",
        "message": "<DisplayTitle> as must be one of 'h1' | 'h2' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|md)$/]",
        "message": "<DisplayTitle> size must be one of 'xl' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeColor|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|time|price|separator|children|key|ref|className|style|children)$/]",
        "message": "<InfoBar> doesn't accept that prop. Declared props: date, time, price, separator, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motif'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|size|color|key|ref|className|style|children)$/]",
        "message": "<Motif> doesn't accept that prop. Declared props: kind, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motif'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:sun|wave|dots)$/]",
        "message": "<Motif> kind must be one of 'sun' | 'wave' | 'dots'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|kicker|align|rule|children|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: as, kicker, align, rule, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h2|h3)$/]",
        "message": "<SectionTitle> as must be one of 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionTitle> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShowCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|description|tags|date|time|price|image|imageColor|href|key|ref|className|style|children)$/]",
        "message": "<ShowCard> doesn't accept that prop. Declared props: title, subtitle, description, tags, date, time, price, image, imageColor, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|indigo|ochre|outline)$/]",
        "message": "<Tag> tone must be one of 'cream' | 'indigo' | 'ochre' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
